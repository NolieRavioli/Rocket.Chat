# Docker Compose Environment Variables for Local Development
# Copy this file to .env and adjust values as needed

# Repository and Docker settings
LOWERCASE_REPOSITORY=rocketchat
DOCKER_TAG=develop

# MongoDB settings
MONGO_URL=mongodb://mongo:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://mongo:27017/local?replicaSet=rs0

# Transporter (NATS message broker)
TRANSPORTER=nats://nats:4222

# Enterprise license (optional - leave empty for community edition)
ENTERPRISE_LICENSE=

# MongoDB configuration
MONGODB_VERSION=8.0
MONGODB_REPLICA_SET_NAME=rs0
MONGODB_PORT_NUMBER=27017
MONGODB_INITIAL_PRIMARY_HOST=mongo
