ROCKETCHAT_IMAGE=rocketchat-cloudless:local
ROCKETCHAT_DOMAIN=chat.lan
ALLOW_SUBNET_1=192.168.1.0/24
ALLOW_SUBNET_2=192.168.2.0/24

# Optional internal SMTP once you are ready to enable email flows.
# Example: smtp://user:password@mail.lan:587/?tls.rejectUnauthorized=false
MAIL_URL=

# Certificate defaults used by the certgen helper.
CERT_COUNTRY=US
CERT_STATE=Colorado
CERT_LOCALITY=Local
CERT_ORGANIZATION=Local Rocket.Chat
CERT_ORGANIZATIONAL_UNIT=IT
CERT_DAYS=825
