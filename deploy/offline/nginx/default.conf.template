map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream rocketchat_upstream {
    server rocketchat:3000;
}

server {
    listen 80;
    server_name ${ROCKETCHAT_DOMAIN};

    allow 127.0.0.1;
    allow ::1;
    allow ${ALLOW_SUBNET_1};
    allow ${ALLOW_SUBNET_2};
    deny all;

    return 301 https://${ROCKETCHAT_DOMAIN}$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${ROCKETCHAT_DOMAIN};

    ssl_certificate /etc/nginx/certs/${ROCKETCHAT_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/certs/${ROCKETCHAT_DOMAIN}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLSCache:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100M;

    allow 127.0.0.1;
    allow ::1;
    allow ${ALLOW_SUBNET_1};
    allow ${ALLOW_SUBNET_2};
    deny all;

    location / {
        proxy_pass http://rocketchat_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
